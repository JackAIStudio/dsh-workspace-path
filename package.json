{
  "name": "dsh-workspace-path",
  "version": "0.4.0",
  "private": true,
  "description": "Sidebar workspace hub and official picker: project workspaces first, day folders one step away, plus session-header path/ID badges.",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "client",
    "paths.js",
    "scripts",
    "cordis.patch.yml",
    "LICENSE",
    "README.zh.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JackAIStudio/dsh-workspace-path.git"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-conversation"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "pack": "node scripts/pack-client.js",
    "test": "node scripts/pack-client.js && node --test test/*.test.js"
  },
  "peerDependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "workspace",
    "clipboard"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22"
  }
}